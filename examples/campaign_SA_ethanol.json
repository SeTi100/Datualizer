    {
      "id": "db_12",
      "path": "${DATUALIZER_SA_DIR}/instrument_reader.db",
      "profile": {
        "name": "instrument_reader_db",
        "description": "instrument_reader-Datenbank (SQLite): OCR-Messwerte je ROI mit Run und Experiment, als Long-Tabelle. readings.timestamp ist Lokalzeit; ungültige Lesungen (is_valid = 0) werden zu leeren Werten. Die Run-Parameter (parameters_json) werden in Spalten zerlegt; aus V_MFC, Temperatur, Volumenstrom, f_Fan … werden v_mfc, temperatur, volumenstrom, f_fan.",
        "reader": "sqlite",
        "file_patterns": [
          "*.db",
          "*.db.bak",
          "*.sqlite",
          "*.sqlite3"
        ],
        "header_hints": [
          "readings",
          "runs",
          "experiments"
        ],
        "sqlite": {
          "query": "SELECT r.timestamp, e.id AS experiment_id, e.name AS experiment_name, e.voc_type, r.run_id, ru.target_temperature, ru.parameters_json AS run_parameters, r.phase_status, r.roi_name, CASE WHEN r.is_valid = 1 THEN r.parsed_value END AS parsed_value, r.unit, r.is_calculated FROM readings r JOIN runs ru ON ru.id = r.run_id JOIN experiments e ON e.id = ru.experiment_id ORDER BY r.timestamp, r.id",
          "json_columns": [
            "run_parameters"
          ]
        },
        "ingestion": {
          "time_column": "timestamp",
          "time": {
            "timezone": "Europe/Zurich"
          },
          "long_format": {
            "mode": "force",
            "variable_col": "roi_name",
            "value_col": "parsed_value",
            "channel_attr_cols": [
              "unit",
              "is_calculated"
            ]
          },
          "roles": {
            "run_columns": [
              "run_id"
            ]
          },
          "quality": {
            "spike_window_s": 31.0,
            "spike_k": 1.0,
            "spike_channels": [
              "masse"
            ],
            "spike_min_scale": {
              "masse": 0.05
            }
          }
        }
      }
    },
    {
      "id": "ocr_12",
      "path": "${DATUALIZER_SA_DIR}/../SA_Analyse/results/ocr_recording_20261012_105012.csv",
      "clock": {
        "offset_s": -15.0,
        "method": "manual",
        "note": "Video-Zeitstempel ca. 15 s zu spät"
      },
      "derived": [
        {
          "name": "masse",
          "expr": "where(is_valid == 1 and mass_g > 9600 and mass_g < 9700, mass_g, nan)",
          "unit": "g",
          "note": "nur gültige und plausible Lesungen (Bereich 9600-9700 g wie im Skript)"
        }
      ]
    },
