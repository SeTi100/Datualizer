      {
        "alias": "S_b",
        "sources": [
          "fid_12",
          "fid_15a",
          "fid_15b",
          "fid_17"
        ],
        "channel": "fid_mgc",
        "window": "blank",
        "min_coverage": 0.5
      },
      {
        "alias": "dS",
        "sources": [
          "fid_12",
          "fid_15a",
          "fid_15b",
          "fid_17"
        ],
        "channel": "fid_mgc",
        "window": "steig",
        "stat": "slope",
        "min_coverage": 0.5
      },
      {
        "alias": "K1",
        "sources": [
          "pico_12",
          "pico_15",
          "pico_17"
        ],
        "channel": "kanal_1_kat_oben",
        "window": "steig"
      },
      {
        "alias": "K2",
        "sources": [
          "pico_12",
          "pico_15",
          "pico_17"
        ],
        "channel": "kanal_2_kat_unten",
        "window": "steig"
      },
      {
        "alias": "dK1",
        "sources": [
          "pico_12",
          "pico_15",
          "pico_17"
        ],
        "channel": "kanal_1_kat_oben",
        "window": "tdrift",
        "stat": "slope"
      },
      {
        "alias": "mdot_w",
        "sources": [
          "db_12",
          "ocr_12",
          "db_15",
          "db_17"
        ],
        "channel": "masse",
        "window": "masse",
        "stat": "slope",
        "min_n": 30,
        "min_coverage": 0.3
      },
      {
        "alias": "I_zyk",
        "sources": [
          "fid_12",
          "fid_15a",
          "fid_15b",
          "fid_17"
        ],
        "channel": "fid_mgc",
        "window": "zyklus",
        "stat": "integral",
        "min_n": 30,
        "exclude_flags": [
          "masked"
        ]
      },
      {
        "alias": "t_zyk",
        "sources": [
          "fid_12",
          "fid_15a",
          "fid_15b",
          "fid_17"
        ],
        "channel": "fid_mgc",
        "window": "zyklus",
        "stat": "covered_s",
        "min_n": 30,
        "exclude_flags": [
          "masked"
        ]
      }
    ],
    "relations": [
      {
        "name": "B",
        "value": "S_b",
        "where": "klasse == 'null' and abs(dS * 60) <= 0.1",
        "match": [
          "temperatur",
          "luft",
          "tag"
        ],
        "fallback": {
          "value": "raumluft",
          "u": 2.0
        },
        "kind": "nearest_reference"
      },
      {
        "name": "beladung",
        "expr": "-(where(isfinite(-(masse_0 - masse_1) / where(isfinite(dauer_journal_s), dauer_journal_s, dauer_s)), -(masse_0 - masse_1) / where(isfinite(dauer_journal_s), dauer_journal_s, dauer_s), mdot_w)) * dauer_s",
        "reset_when": "(klasse == 'null' and dauer_s >= 300) or changed(temperatur)",
        "kind": "cumulative"
      },
      {
        "name": "T_klasse",
        "expr": "(K1 + K2) / 2",
        "width": 25.0,
        "kind": "bin"
      }
    ],
    "calculations": [
      {
        "name": "mdot_j",
        "expr": "-(masse_0 - masse_1) / where(isfinite(dauer_journal_s), dauer_journal_s, dauer_s)",
        "u_expr": "sqrt((sqrt(2) * u_masse / where(isfinite(dauer_journal_s), dauer_journal_s, dauer_s))**2 + ((masse_0 - masse_1) * sqrt(2) * u_zeit / where(isfinite(dauer_journal_s), dauer_journal_s, dauer_s)**2)**2)",
        "unit": "g/s",
        "note": "Journal: Start- und Endmasse"
      },
      {
        "name": "mdot",
        "expr": "where(isfinite(mdot_j), mdot_j, mdot_w) * k_mdot",
        "unit": "g/s",
        "note": "Journal, sonst Regression der Waage"
      },
      {
        "name": "V_N",
        "expr": "luft * k_luft * 273.15 / (T_ref + 273.15)",
        "unit": "Nm3/h"
      },
      {
        "name": "c_in",
        "expr": "-mdot * 3600 * 1000 / V_N",
        "unit": "mg/Nm3"
      },
      {
        "name": "dXdt",
        "expr": "-dS * 60 * f / c_in",
        "unit": "1/min"
      },
      {
        "name": "drift",
        "expr": "0",
        "u_expr": "where(isfinite(dXdt), abs(dXdt) * drift_h, 0)",
        "note": "Restdrift: so weit kann X nach dem Stufenende noch wandern"
      },
      {
        "name": "X",
        "expr": "1 - (S - B) * f * k_kal / c_in + drift"
      },
      {
        "name": "T_bett",
        "expr": "(K1 + K2) / 2",
        "u_expr": "sqrt(1.5**2 + (K1 - K2)**2 / 12)",
        "unit": "°C",
        "note": "Thermoelement ⊕ Bett-Gradient (Rechteck)"
      },
      {
        "name": "dosiert",
        "expr": "-mdot * 1000 * dauer_s",
        "unit": "mg",
        "note": "dosierte Masse Ethanol"
      },
      {
        "name": "sichtbar",
        "expr": "(I_zyk - where(isfinite(B_vor), B_vor, raumluft) * t_zyk) * f * V_N / 3600",
        "unit": "mg",
        "note": "∫(FID − Blindwert vorher) · f · V̇_N dt über den Zyklus"
      },
      {
        "name": "anteil",
        "expr": "sichtbar / dosiert",
        "note": "FID-sichtbar / dosiert"
      },
      {
        "name": "k",
        "expr": "V_N * (T_bett + 273.15) / 273.15 / V_kat / 3600 * -log(1 - X)",
        "unit": "1/s"
      }
    ],
    "criteria": [
      {
        "name": "c_ok",
        "expr": "c_in >= 60",
        "text": "c_in < 60"
      },
      {
        "name": "flach",
        "expr": "abs(dS * 60) <= 0.1 or abs(dXdt) <= 0.004",
        "text": "nicht stationär: FID nicht flach"
      },
      {
        "name": "t_ok",
        "expr": "not (abs(dK1 * 600) > 5)",
        "text": "nicht stationär: Temperatur driftet"
      },
      {
        "name": "geladen",
        "expr": "beladung >= 3",
        "text": "nicht stationär: Speicherphase (< 3 g dosiert)"
      },
      {
        "name": "stationaer",
        "expr": "flach and t_ok and geladen",
        "text": "nicht stationär"
      },
      {
        "name": "b_ok",
        "expr": "B_art != 'keiner'",
        "text": "kein Blindwert"
      },
      {
        "name": "spread_ok",
        "expr": "(abs(B_vor - B_nach) if B_art == 'eingeklammert' else 1) * f / c_in <= 0.05",
        "text": "Blindwahl ändert X > Grenze"
      }
    ],
    "ratings": [
      {
        "label": "gut",
        "all_of": [
          "c_ok",
          "stationaer",
          "b_ok",
          "spread_ok"
        ]
      },
      {
        "label": "brauchbar",
        "all_of": [
          "c_ok"
        ],
        "any_of": [
          "stationaer",
          "b_ok"
        ]
      },
      {
        "label": "unsicher"
      }
    ],
    "analyses": [
      {
        "name": "T50",
        "x": "T_bett",
        "y": "X",
        "level": 0.5,
        "group": "v_mfc",
        "u_y": "u_X",
        "where": "stationaer and bewertung != 'unsicher' and c_ok and luft == 100",
        "unit": "°C",
        "kind": "crossing"
      },
      {
        "name": "T90",
        "x": "T_bett",
        "y": "X",
        "level": 0.9,
        "group": "v_mfc",
        "u_y": "u_X",
        "where": "stationaer and bewertung != 'unsicher' and c_ok and luft == 100",
        "unit": "°C",
        "kind": "crossing"
      },
      {
        "name": "Arrhenius",
        "x_expr": "1000 / (T_bett + 273.15)",
        "y_expr": "log(k)",
        "u_x": "1000 * u_T_bett / (T_bett + 273.15)**2",
        "u_y": "u_X_zufall / ((1 - X) * -log(1 - X))",
        "where": "stationaer and bewertung != 'unsicher' and c_ok and luft == 100 and X > 0.05 and X < 0.8",
        "derived": {
          "Ea_kJ_mol": "-m * 8.314"
        },
        "kind": "fit_line"
      }
    ],
    "views": [
